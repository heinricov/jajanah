# Salin file ini ke .env (atau .env.development / .env.test / .env.production).
# Semua nilai env dibaca dari root repo oleh @packages/environment — SSOT tunggal.
# Format: KEY=value. Variabel ${KEY} di-expand. Variabel yang sudah ada di
# process.env (shell/CI) SELALU menang.
# Mode mengikuti NODE_ENV (development | test | production, default development):
# file .env.<mode> menimpa .env — jangan set NODE_ENV sendiri di sini (Next.js
# menyetelnya; nilai non-standar bikin warning).

# Ditampilkan di halaman web & admin (di-inline oleh Next.js saat build).
NEXT_PUBLIC_APP_NAME=jajanah

# Alamat API yang dipanggil @packages/client dari web/admin (di-inline Next, NEXT_PUBLIC_*).
# Di mode development pakai http://localhost:3002 (override di .env.development).
NEXT_PUBLIC_API_URL=https://api.jajanah.example

# Alamat publik API yang DILAPORKAN oleh API-nya sendiri (field `baseUrl` di GET /).
API_BASE_URL=https://api.jajanah.example

# Nama layanan untuk API (apps/api) — dibaca via @packages/environment.
APP_NAME=jajanah

# Port HTTP API (apps/api) — dibaca main.ts via process.env (fallback: 3002).
API_PORT=3002

# Port dev/start web & admin — dibaca bin next-app (@configs/next) dari env.
# Urutan: env ini > argumen script > fallback bawaan app (web 3000, admin 3001).
WEB_PORT=3000
ADMIN_PORT=3001

# Koneksi database PostgreSQL (@packages/db — Prisma ORM).
# Nilai asli hanya ada di .env (gitignored). Jangan pernah commit kredensial.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
PRISMA_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Level & format log @packages/logger (apps/api, dibaca via getEnv di
# apps/api/src/logger.ts). Nilai sah:
# LOG_LEVEL=debug|info|warn|error — default: info (prod) / debug (dev).
# LOG_FORMAT=json|pretty          — default: json (prod) / pretty (dev).
# Di .env.test disarankan LOG_LEVEL=error supaya output unit test bersih.
LOG_LEVEL=info
LOG_FORMAT=json

# Auth (@packages/auth — JWT HS256 untuk sesi login).
# JWT_SECRET: tanda tangan token sesi. Buat baru: openssl rand -base64 48
# Nilai asli hanya di .env (gitignored) — tanpa ini login/register gagal saat sign.
JWT_SECRET=CHANGE_ME_base64_random_48_char

# Umur sesi dalam jam — 168 = 7 hari. Dipakai untuk exp JWT dan kolom Session.expiresAt.
AUTH_SESSION_TTL_HOURS=168

# Login dengan Google (OAuth 2.0 — @packages/auth/next/oauth, hanya apps/web).
# Keduanya WAJIB diisi agar tombol "Continue with Google" berfungsi; kosong = redirect
# ke /auth/login?error=oauth_config. Cara mendapatkannya: lihat panduan langkah-demi-langkah
# di packages/auth/README.md → "Login dengan Google (OAuth)" (Google Cloud Console →
# OAuth consent screen → Credentials → OAuth client ID tipe "Web application").
# Authorized redirect URI (dev): http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# Konfirmasi email registrasi & reset password (@packages/email — adapter Resend;
# kirim ulang via resendVerificationAction / forgotPasswordAction). RESEND_API_KEY
# kosong → fallback console: tautan di-log ke server (cukup untuk development/
# testing tanpa Resend). Cara dapat: https://resend.com/api-keys. MAIL_FROM: alamat
# pengirim — di produksi pakai domain yang sudah diverifikasi di Resend.
# APP_URL: basis URL publik app untuk tautan konfirmasi/reset (dev: http://localhost:3000).
# VERIFY_TOKEN_TTL_HOURS: umur tautan konfirmasi (jam) — kosong/tidak valid = 24.
# RESET_TOKEN_TTL_HOURS: umur tautan reset password (jam) — kosong/tidak valid = 1.
#
# ⚠ JANGAN menyalin baris RESEND_API_KEY kosong ke .env.development/.env.test:
# @packages/environment memuat .env lalu .env.<mode> dengan Object.assign, jadi
# file dimuat BELAKANGAN menimpa. Baris kosong di .env.development akan menimpa
# key asli di .env → aplikasi diam-diam jatuh ke fallback console, tidak ada
# email terkirim (gejala: lupa password selalu "berhasil" tapi inbox kosong).
# Di file .env.<mode> isi key yang SAMA dengan .env, atau hapus barisnya.
# Diagnosa: panggil loadEnvironment({ mode: 'development' }) lalu cek key-nya.
#
# 📨 MAIL_FROM default Jajanah <onboarding@resend.dev> HANYA boleh mengirim ke
# email pemilik akun Resend Anda (email lain → Resend tolak). Untuk mengirim ke
# alamat mana pun, tambahkan lalu verifikasi domain sendiri di dashboard Resend
# dan ganti MAIL_FROM (domain → status "Verified"; lalu .env.production juga).
# Kalau email "diterima API" tapi statusnya suppressed: alamat penerima ada di
# dashboard → Suppressions → Remove (API: DELETE /suppressions/{email}).
RESEND_API_KEY=
MAIL_FROM=Jajanah <onboarding@resend.dev>
APP_URL=http://localhost:3000
VERIFY_TOKEN_TTL_HOURS=24
RESET_TOKEN_TTL_HOURS=1
