# Salin file ini ke .env (atau .env.development / .env.test / .env.production).
# Semua nilai env dibaca dari root repo oleh @packages/environment — SSOT tunggal.
# Format: KEY=value. Variabel ${KEY} di-expand. Variabel yang sudah ada di
# process.env (shell/CI) SELALU menang.

# Ditampilkan di halaman web & admin (di-inline oleh Next.js saat build).
NEXT_PUBLIC_APP_NAME=jajanah

# Nama layanan untuk API (apps/api) — dibaca via @packages/environment.
APP_NAME=jajanah

# Port HTTP API (apps/api).
API_PORT=3002

# Port dev/start web & admin (dibaca bin next-app dari @configs/next).
WEB_PORT=3000
ADMIN_PORT=3001

# Contoh variabel server-only (tidak perlu prefix NEXT_PUBLIC_).
API_BASE_URL=https://api.jajanah.example

# Koneksi database PostgreSQL (@packages/db — Prisma ORM).
# Nilai asli hanya ada di .env (gitignored). Jangan pernah commit kredensial.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
PRISMA_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
