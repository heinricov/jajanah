{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@configs/typescript/node.json",
  "compilerOptions": {
    "types": ["node", "jest"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
