generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model Auth {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  email           String    @unique
  password        String?
  role            Role      @default(USER)
  lastLoginAt     DateTime?
  isActive        Boolean   @default(true)
  /**
   * URL foto profil yang DITAMPILKAN (ditalin dari OAuthAccount saat login
   * terakhir; akun email+password → null → UI pakai inisial). Sumber aslinya
   * ada di `OAuthAccount.image` — kolom ini hanya untuk baca tanpa join.
   */
  image           String?
  /**
   * Konfirmasi email pertama — null = belum diverifikasi (blokir login).
   */
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions                Session[]
  oAuthAccounts           OAuthAccount[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
}

model OAuthAccount {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String
  providerId String
  email      String
  authId     String   @db.Uuid
  /**
   * URL foto yang dikembalikan penyedia (Google `picture`) — sumber kebenaran
   * per penyedia. Disalin ke `Auth.image` agar tampilan tidak butuh join.
   */
  image      String?
  createdAt  DateTime @default(now())

  auth Auth @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([authId])
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  authId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  auth Auth @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@index([authId])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  authId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  auth Auth @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@index([authId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  authId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  authAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  auth Auth @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@index([authId])
}
